<% html_title l(:label_gantrix_kanban) %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'gantrix', plugin: 'redmine_gantrix', media: 'all' %>
  <%= javascript_include_tag 'gantrix/core', 'gantrix/kanban', plugin: 'redmine_gantrix', defer: true %>
<% end %>

<h2><%= l(:label_gantrix_kanban) %></h2>
<%= content_tag :div, '', id: 'gantrix-kanban', data: {
      config: {
        dataUrl: project_gantrix_api_kanban_path(project_id: @project),
        apiUrl: gantrix_api_url(@project),
        issuesUrl: issues_path,
        project: @project.identifier,
        messages: gantrix_messages
      }.to_json
    } %>
